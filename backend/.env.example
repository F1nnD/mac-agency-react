# Sao chép thành backend/.env rồi điền giá trị thật. KHÔNG commit file .env.

# ---- Bắt buộc ----
# Dùng database RIÊNG của MAC, tên nằm ngay sau dấu / cuối của chuỗi (vd /mac_agency)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/mac_agency?retryWrites=true&w=majority
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_EXPIRES_IN=7d
PORT=5000
CORS_ORIGINS=http://localhost:5173,https://ten-mien-cua-ban.com

# ---- AI miễn phí (Google AI Studio: https://aistudio.google.com/apikey) ----
# Để trống vẫn chạy: AI Studio dùng bộ quy tắc thiết kế dự phòng, chat AI báo "đang nghỉ".
GEMINI_API_KEY=
# Danh sách model thử lần lượt (tuỳ chọn)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash

# Ảnh phối cảnh (Pollinations, miễn phí, không cần key) — tuỳ chọn
# IMAGE_MODEL=flux
# IMAGE_WIDTH=1024
# IMAGE_HEIGHT=768

# ---- Hạn mức AI (tuỳ chọn, đây là giá trị mặc định) ----
# Số ảnh diễn hoạ: khách thường 1 lượt / 3 ngày, Pro 3 lượt / ngày, nhân viên 100 lượt / ngày, admin không giới hạn
# AI_RENDER_LIMIT_FREE=1
# AI_RENDER_DAYS_FREE=3
# AI_RENDER_LIMIT_PRO=3
# AI_RENDER_LIMIT_STAFF=100
# Số tin nhắn chat AI mỗi ngày
# AI_CHAT_LIMIT_GUEST=10
# AI_CHAT_LIMIT_FREE=30
# AI_CHAT_LIMIT_PRO=300
# AI_CHAT_LIMIT_STAFF=500
# Chỉ để thử nghiệm cục bộ (bị bỏ qua khi NODE_ENV=production): tắt kiểm tra hạn mức
# AI_QUOTA_BYPASS=false

# ---- Dự toán sơ bộ (tuỳ chọn) ----
# ESTIMATE_CONTINGENCY_PCT=5
# ESTIMATE_PRICE_MAX_AGE_DAYS=120

# ---- Báo lead nóng cho telesale (tuỳ chọn; cấu hình một hoặc cả hai) ----
# HOT_LEAD_SCORE=70
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# HOT_LEAD_WEBHOOK_URL=

# ---- Chỉ dùng khi chạy: node scripts/seedAdmin.js ----
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# ---- Email đặt lại mật khẩu (Resend: https://resend.com) — tuỳ chọn ----
# Thiếu thì hệ thống chỉ ghi log, không gửi thư (ngoài production sẽ in đường dẫn đặt lại ra console)
# RESEND_API_KEY=
# MAIL_FROM=MAC Concept <no-reply@ten-mien-cua-ban.com>
# APP_URL=https://moreactisticconcept.onrender.com

# ---- Kho ảnh Cloudinary (lưu bền ảnh mặt bằng và ảnh phối cảnh) — tuỳ chọn ----
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=mac-concept
# STORAGE_ALLOWED_HOSTS=
# Thử nghiệm: vẽ ảnh-sang-ảnh bám ảnh hiện trạng (cần Cloudinary). Mặc định tắt, chưa kiểm chứng
# IMAGE_REF_MODE=off
